# ── Dagster ────────────────────────────────────────────────────────────────────
# Absolute path where Dagster stores its metadata database and logs
DAGSTER_HOME=/opt/my_data_platform/dagster_home

# ── DuckDB ─────────────────────────────────────────────────────────────────────
# Absolute path to the DuckDB database file
DUCKDB_PATH=/opt/my_data_platform/data/platform.duckdb

# ── 8x8 Work Analytics API ─────────────────────────────────────────────────────
# Used by pipeline/assets/sources/eight_x_eight_cdr.py
#
# EIGHT_X_EIGHT_BASE_URL  – Base URL of the 8x8 Analytics API.
#                           Check your 8x8 admin portal for the correct URL.
# EIGHT_X_EIGHT_API_KEY   – API key. Sent as the `8x8-apikey` request header.
#                           Generate one in the 8x8 Admin Console under
#                           Analytics > API Access.
# EIGHT_X_EIGHT_PBX_ID    – The PBX ID you want to query.
#                           Use `allpbxes` to pull data for all PBXs in the
#                           account (requires appropriate permissions).
# Base URL for all 8x8 API calls (token exchange and CDR data)
EIGHT_X_EIGHT_BASE_URL=https://api.8x8.com
# Admin Provisioning API — separate credentials from the Analytics API
# Token endpoint and API key differ from the CDR/Analytics credentials above
EIGHT_X_EIGHT_ADMIN_TOKEN_URL=https://api.8x8.com/oauth2/token
EIGHT_X_EIGHT_ADMIN_API_KEY=your_admin_api_key_here
# Azure Blob Storage container where 8x8 CDR data will be stored
EIGHT_X_EIGHT_CONTAINER=8x8-cdr
# API key sent as the `8x8-apikey` header to the token endpoint
EIGHT_X_EIGHT_API_KEY=your_8x8_api_key_here
# Credentials used to obtain a Bearer token via POST /v1/oauth/token
EIGHT_X_EIGHT_USERNAME=your_8x8_username_here
EIGHT_X_EIGHT_PASSWORD=your_8x8_password_here
# PBX IDs are not configured here — they are read at runtime from
# dbt_project/seeds/8x8/pbx_country_mapping.csv, which is the single source
# of truth for both the ingestion pipeline and the dbt country mapping.
# To add or remove a PBX, edit only that one file.

# ── REST API sources (generic template) ────────────────────────────────────────
# Add one block per additional REST API source you want to ingest.
# These are read in pipeline/assets/sources/rest_api.py
REST_API_BASE_URL=https://api.example.com
REST_API_TOKEN=your_bearer_token_here

# ── SFTP source ────────────────────────────────────────────────────────────────
SFTP_HOST=sftp.example.com
SFTP_PORT=22
SFTP_USERNAME=your_sftp_user
SFTP_PASSWORD=your_sftp_password
# Path on the SFTP server that contains the CSV files
SFTP_PATH=/data/exports/

# ── Azure (ADLS Gen2 / OneLake + Blob export) ──────────────────────────────────
# Used by the DuckDB azure extension to read Delta tables from OneLake/ADLS,
# and by the Parquet export step to write output files to Azure Blob Storage.

# Option A – Service principal / App Registration (recommended)
# Provided by IT: Application (client) ID, Directory (tenant) ID, client secret
AZURE_TENANT_ID=your_directory_tenant_id
AZURE_CLIENT_ID=your_application_client_id
AZURE_CLIENT_SECRET=your_client_secret
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount

# Option B – Storage account key (simpler but less secure)
# AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key

# Option C – Connection string
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;...

# Container and path where Delta tables (from Fabric/Synapse Link) are stored
ADLS_CONTAINER=dataverse-export
ADLS_DELTA_PATH=Tables/your_entity_name

# Container and path where Parquet exports for Power BI will be written
EXPORT_CONTAINER=powerbi-exports
EXPORT_PATH=marts/
