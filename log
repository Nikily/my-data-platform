# Install uv (one-time, manages isolated Python builds)
curl -LsSf https://astral.sh/uv/install.sh | sh
source ~/.bashrc

# Get Python 3.12 (matches what the whole dagster-* ecosystem currently targets)
uv python install 3.12

# Rebuild the venv against 3.12 instead of system python3 (3.14)
rm -rf /opt/my_data_platform/.venv
uv venv /opt/my_data_platform/.venv --python 3.12

cd /opt/my_data_platform
source .venv/bin/activate
pip install --upgrade pip setuptools
pip install -e .
python scripts/install_duckdb_extensions.py

cd dbt_project
dbt deps --profiles-dir . --project-dir .
set -a; source ../.env; set +a
export DUCKDB_PATH="${DUCKDB_PATH:-$PWD/../data/platform.duckdb}"
dbt parse --profiles-dir . --project-dir .
cd ..

sudo systemctl start dagster-webserver dagster-daemon
sudo systemctl status dagster-webserver dagster-daemon

This mirrors setup.sh's steps 3–5 manually (skipping its system-Python auto-detection, which would otherwise just find python3 → 3.14 again). Your requirements.txt's frozen snapshot (dagster==1.12.20 etc.) is proof this exact package family resolves cleanly on an older interpreter — we're just giving pip a Python version where that combination actually has wheels.

